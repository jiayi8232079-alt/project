# Server
PORT=3000
NODE_ENV=production
API_BASE_URL=https://api.example.com
CORS_ORIGIN=https://admin.example.com
SWAGGER_ENABLED=false

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=qiaoguo_user
DB_PASSWORD=replace_with_strong_password
DB_DATABASE=qiaoguo_health

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=replace_with_random_long_secret
JWT_EXPIRES_IN=7d

# Third-party API（医院/医生目录对接）
THIRD_PARTY_API_KEY=

# Seed admin
# Fresh database can turn this on once for first-time initialization.
# If you import `数据库.sql`, usually keep this false.
SEED_DEFAULT_ADMIN=false
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ChangeMe123456

# WeChat Mini Program（须与小程序 project.config.json 的 appid 一致）
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret
#WECHAT_MP_QR_ENV_VERSION=trial
MINI_PROGRAM_TEMPLATE_MEDICATION_REMINDER=
MINI_PROGRAM_TEMPLATE_ORDER_SERVICE_REMINDER=
MINI_PROGRAM_TEMPLATE_ORDER_ASSIGN_NOTIFY=
MINI_PROGRAM_TEMPLATE_GRAB_POOL_NOTIFY=
MINI_PROGRAM_TEMPLATE_ORDER_STATUS_NOTIFY=

# Tencent Cloud COS
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# WeChat Work Bot
WECHAT_WORK_BOT_WEBHOOK=
