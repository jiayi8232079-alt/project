# Server
PORT=3000
NODE_ENV=development
# 生产环境必须配置，逗号分隔多个来源。例如：
# CORS_ORIGIN=https://admin.qiaoguo.vip
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
SWAGGER_ENABLED=true

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=qiaoguo_health

# ─── 读写分离（可选，仅配置 DB_SLAVE1_HOST 时启用）──────────────
# 启用后 SELECT 默认走从库，写操作走主库（DB_HOST）。单库部署留空即可。
# DB_SLAVE1_HOST=
# DB_SLAVE1_PORT=3306
# DB_SLAVE1_USERNAME=
# DB_SLAVE1_PASSWORD=

# ─── 首次部署（空库）────────────────────────────────────────────
# 生产环境默认不同步表结构。空库第一次启动前可二选一：
# A) 暂时设 DB_SYNCHRONIZE=true 启动一次生成全部表，然后改回 false 再重启；
# B) 自行执行迁移 / 手工建库后再启动。
DB_SYNCHRONIZE=false
#
# 启动时自动写入「缺的」system_configs 默认值，并在医院表为空时导入骨架名录
#（丽水+温州 + 杭州+上海，数据来自代码仓库种子，非数据库 dump）。
AUTO_BOOTSTRAP_DEFAULT_DATA=false
#
# 若库内已有医院数据，仍希望把仓库里新增的骨架医院合并进来，设为 true（按名称+市+区县去重）。
BOOTSTRAP_MERGE_HOSPITAL_SEEDS=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI 网关用量限额：每用户每日 MCP 工具调用硬上限（防刷光额度），默认 1000
AI_DAILY_CALL_CAP=1000

# JWT
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

# Third-party API（医院/医生目录对接）
# 访问 /third-party/hospitals* 时通过 Header: x-api-key 传入
THIRD_PARTY_API_KEY=

# Seed admin (optional, development only)
SEED_DEFAULT_ADMIN=false
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=

# 高德地图 Web 服务（医院名录「从高德补全」）：https://console.amap.com/dev/key/app
# 请使用「Web 服务」类型 Key，生产环境务必配置 IP 白名单；用量与展示须遵守高德条款。
AMAP_WEB_KEY=

# WeChat Mini Program（须与小程序 project.config.json 的 appid 一致）
WECHAT_APPID=
WECHAT_SECRET=
# 管理端生成小程序码：未发正式版时可设 trial / develop，上线后 release
#WECHAT_MP_QR_ENV_VERSION=trial
MINI_PROGRAM_TEMPLATE_MEDICATION_REMINDER=
MINI_PROGRAM_TEMPLATE_ORDER_SERVICE_REMINDER=

# Tencent Cloud COS
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PATH_PREFIX=
COS_CUSTOM_DOMAIN=
COS_USE_HTTPS=true
STORAGE_DRIVER=local

# ─── Tencent Cloud SMS（短信通知，生产建议走管理端「系统配置 → 短信通知」动态配置）──
# 以下变量仅作为 system_configs 缺失时的兜底，非生产环境也可直接写到 .env 快速联调。
# 需要先在腾讯云控制台完成：签名报备 + 正文模板报备 + 应用 SdkAppId。
# 国内短信 Region 固定 ap-guangzhou，代码已写死，无需配置。
TENCENT_SMS_ENABLED=false
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_MEDICATION_REMINDER=
TENCENT_SMS_TEMPLATE_FOLLOW_UP_REMINDER=

# ─── AI 智能问诊（可在后台系统配置页面动态配置，此处为初始默认值）──
# 支持 DeepSeek / 通义千问 / GLM-4 等 OpenAI 兼容 API
# 本地开发默认可使用 Ollama / LM Studio 的 OpenAI 兼容接口。
# Ollama 示例：
#   ollama pull qwen2.5:7b
#   ollama serve
# AI_API_KEY=local-dev
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=qwen2.5:7b
#
# 健康材料「上传图片」解读：后台「AI 智能问诊」→ 视觉模型 (ai_vision_model)，可选读图专用 ai_vision_api_key / ai_vision_base_url
#（与语音 Whisper 无关）。须为兼容 OpenAI 的多模态 chat 接口（如 gpt-4o-mini）。留空视觉模型则服务端不附图像素。
#
# 语音转文字（小程序 AI 顾问「按住说话」）：在管理后台系统配置中填写 speech_api_key 等，或使用与上方相同的兼容接口。
# SPEECH_API_KEY=（通常与 OpenAI 兼容的密钥，后台键名 speech_api_key）
# SPEECH_API_BASE=https://api.openai.com/v1
# SPEECH_MODEL=whisper-1
