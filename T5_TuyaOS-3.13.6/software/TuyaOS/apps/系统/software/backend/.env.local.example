# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
SWAGGER_ENABLED=true

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=qiaoguo_local

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=qiaoguo-health-local-dev-secret
JWT_EXPIRES_IN=7d

# Third-party API（医院/医生目录对接）
THIRD_PARTY_API_KEY=

# Seed admin
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=123456

# WeChat Mini Program
WECHAT_APPID=
WECHAT_SECRET=

# Tencent Cloud COS
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# WeChat Work Bot
WECHAT_WORK_BOT_WEBHOOK=

# Local AI model (OpenAI-compatible, e.g. Ollama / LM Studio)
AI_API_KEY=local-dev
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen2.5:7b
