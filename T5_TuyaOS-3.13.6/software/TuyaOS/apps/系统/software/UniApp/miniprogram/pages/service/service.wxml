<view class="page">
  <!-- 顶部导航 -->
  <view class="glass-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="glass-nav__inner">
      <text class="glass-nav__title">我的服务</text>
    </view>
  </view>

  <view wx:if="{{pageNeedsLogin}}" class="page-login-gate">
    <view class="page-login-gate__card">
      <text class="page-login-gate__title">登录后查看服务</text>
      <text class="page-login-gate__desc">订单与预约记录需登录后查看。您可先逛首页了解服务，需要时再自愿登录。</text>
      <button class="page-login-gate__btn" bind:tap="goLoginFromGate">去登录</button>
      <view class="page-login-gate__skip" bind:tap="backFromGate">返回</view>
    </view>
  </view>

  <block wx:else>
  <!-- 状态Tab -->
  <view class="tab-wrap">
    <view class="tab-bar">
      <view
        class="tab-item {{currentTab === 'all' ? 'tab-item--active' : ''}}"
        bind:tap="switchTab" data-tab="all"
      >
        <text>全部</text>
      </view>
      <view
        class="tab-item {{currentTab === 'pending' ? 'tab-item--active' : ''}}"
        bind:tap="switchTab" data-tab="pending"
      >
        <text>待确认</text>
      </view>
      <view
        class="tab-item {{currentTab === 'in_progress' ? 'tab-item--active' : ''}}"
        bind:tap="switchTab" data-tab="in_progress"
      >
        <text>进行中</text>
      </view>
      <view
        class="tab-item {{currentTab === 'completed' ? 'tab-item--active' : ''}}"
        bind:tap="switchTab" data-tab="completed"
      >
        <text>已完成</text>
      </view>
      <view
        class="tab-item {{currentTab === 'canceled' ? 'tab-item--active' : ''}}"
        bind:tap="switchTab" data-tab="canceled"
      >
        <text>已取消</text>
      </view>
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view scroll-y class="order-list" bindscrolltolower="loadMore">
    <view class="list-content">
      <!-- 加载失败 -->
      <view wx:if="{{loadError && !loading}}" class="empty-state">
        <view class="empty-state__icon">
          <text class="material-symbols-outlined">wifi_off</text>
        </view>
        <text class="empty-state__text">加载失败</text>
        <text class="empty-state__sub">请检查网络后重试</text>
        <view class="empty-state__retry" bind:tap="resetAndLoad">点击重试</view>
      </view>

      <!-- 空状态 -->
      <view wx:elif="{{orders.length === 0 && !loading}}" class="empty-state">
        <view class="empty-state__icon">
          <text class="material-symbols-outlined">clinical_notes</text>
        </view>
        <text class="empty-state__text">暂无订单记录</text>
        <text class="empty-state__sub">点击首页服务入口开始预约</text>
      </view>

      <!-- 订单卡片 -->
      <view
        wx:for="{{orders}}" wx:key="id"
        class="order-card"
        bind:tap="goDetail" data-id="{{item.id}}"
        hover-class="btn-haptic"
      >
        <!-- 卡片头部 -->
        <view class="order-card__header">
          <view class="order-card__type-wrap">
            <view class="order-card__type-icon order-card__type-icon--{{item.status}}">
              <text class="material-symbols-outlined">{{item.iconName || 'medical_services'}}</text>
            </view>
            <text class="order-card__type-name">{{item.serviceType}}</text>
          </view>
          <view class="order-card__status order-card__status--{{item.status}}">
            <text>{{item.statusText}}</text>
          </view>
        </view>

        <!-- 卡片内容 -->
        <view class="order-card__body">
          <view class="order-card__row" wx:if="{{item.serviceTargetName}}">
            <text class="order-card__label">服务对象</text>
            <text class="order-card__value">{{item.serviceTargetName}}</text>
          </view>
          <view class="order-card__row">
            <text class="order-card__label">预约时间</text>
            <text class="order-card__value">{{item.serviceTime}}</text>
          </view>
          <view class="order-card__row">
            <text class="order-card__label">服务地点</text>
            <text class="order-card__value">{{item.hospital || '待确认'}}</text>
          </view>
        </view>

        <!-- 卡片底部按钮 -->
        <view class="order-card__footer">
          <block wx:if="{{item.recordType === 'consultation'}}">
            <view class="order-card__actions">
              <view class="order-card__btn order-card__btn--primary" catch:tap="onContactForConsultation" data-id="{{item.id}}">
                <text>联系客服</text>
              </view>
            </view>
          </block>
          <block wx:elif="{{item.status === 'pending_service' || item.status === 'pending_sign' || item.status === 'pending_dispatch' || item.status === 'pending_accept' || item.status === 'pending_grab'}}">
            <view class="order-card__actions">
              <view class="order-card__btn order-card__btn--outline" catch:tap="onCancelOrder" data-id="{{item.id}}">
                <text>取消订单</text>
              </view>
              <view class="order-card__btn order-card__btn--primary" catch:tap="onContactStore" data-id="{{item.id}}">
                <text>联系门店</text>
              </view>
            </view>
          </block>
          <view wx:elif="{{item.status === 'in_progress' || item.status === 'emergency'}}" class="order-card__actions">
            <view class="order-card__btn order-card__btn--green-outline" catch:tap="goDetail" data-id="{{item.id}}">
              <text>查看进度</text>
            </view>
          </view>
          <view wx:elif="{{item.status === 'completed' || item.status === 'pending_review'}}" class="order-card__actions">
            <view class="order-card__btn order-card__btn--outline" catch:tap="goDetail" data-id="{{item.id}}">
              <text>查看报告</text>
            </view>
            <view class="order-card__btn order-card__btn--outline" catch:tap="onRebook" data-id="{{item.id}}">
              <text>再次预约</text>
            </view>
            <view wx:if="{{!item.reviewed}}" class="order-card__btn order-card__btn--primary" catch:tap="onGoReview" data-id="{{item.id}}">
              <text>去评价</text>
            </view>
            <view wx:else class="order-card__btn order-card__btn--outline" catch:tap="onGoReview" data-id="{{item.id}}">
              <text>查看评价</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 加载更多 -->
      <view wx:if="{{loading}}" class="loading-more">
        <text>加载中...</text>
      </view>
      <view wx:if="{{noMore && orders.length > 0}}" class="loading-more">
        <text class="no-more-text">— 没有更多了 —</text>
      </view>
    </view>
  </scroll-view>
  </block>
</view>
