<view class="med-page">

  <!-- 导航栏 -->
  <view class="med-page__nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="med-page__nav-back" bind:tap="goBack" hover-class="btn-haptic">
      <text class="material-symbols-outlined med-page__nav-back-icon">arrow_back</text>
    </view>
    <text class="med-page__nav-title">用药与复诊提醒</text>
    <view class="med-page__nav-side"></view>
  </view>

  <view wx:if="{{pageNeedsLogin}}" class="page-login-gate">
    <view class="page-login-gate__card">
      <text class="page-login-gate__title">登录后管理提醒</text>
      <text class="page-login-gate__desc">用药与复诊提醒仅对本人账号展示。您可先返回了解其他服务，需要时再自愿登录。</text>
      <button class="page-login-gate__btn" bind:tap="goLoginFromGate">去登录</button>
      <view class="page-login-gate__skip" bind:tap="backFromGate">返回</view>
    </view>
  </view>

  <!-- 滚动区域 -->
  <scroll-view
    wx:else
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    class="med-page__scroll"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="med-page__body">

      <!-- 切换标签 -->
      <view class="med-page__tabs">
        <view
          class="med-page__tab {{activeTab === 'active' ? 'med-page__tab--active' : ''}}"
          data-tab="active"
          bind:tap="switchTab"
        >进行中</view>
        <view
          class="med-page__tab {{activeTab === 'all' ? 'med-page__tab--active' : ''}}"
          data-tab="all"
          bind:tap="switchTab"
        >全部</view>
      </view>

      <!-- 新建提醒 -->
      <view class="med-page__editor" wx:if="{{showCreatePanel}}">
        <view class="med-page__editor-row">
          <text class="med-page__editor-label">药品名称</text>
          <input class="med-page__editor-input" placeholder="如：阿司匹林" placeholder-class="med-page__editor-input-placeholder" value="{{createForm.medicineName}}" data-field="medicineName" bindinput="onCreateInput" />
        </view>
        <view class="med-page__editor-row">
          <text class="med-page__editor-label">剂量（选填）</text>
          <picker mode="selector" range="{{dosageOptions}}" value="{{selectedDosageIndex}}" bindchange="onDosageChange" disabled="{{!dosageOptions.length}}">
            <view class="med-page__editor-picker">
              <text class="med-page__editor-picker-val {{selectedDosageIndex > -1 ? '' : 'med-page__editor-picker-val--empty'}}">
                {{selectedDosageIndex > -1 ? dosageOptions[selectedDosageIndex] : (dosageOptions.length ? '请选择剂量' : '字典加载失败')}}
              </text>
              <text class="material-symbols-outlined med-page__editor-picker-icon">expand_more</text>
            </view>
          </picker>
        </view>
        <view class="med-page__editor-row">
          <text class="med-page__editor-label">服务对象（选填）</text>
          <picker mode="selector" range="{{serviceTargets}}" range-key="name" value="{{selectedServiceTargetIndex}}" bindchange="onServiceTargetChange">
            <view class="med-page__editor-picker">
              <text class="med-page__editor-picker-val {{selectedServiceTargetIndex > -1 ? '' : 'med-page__editor-picker-val--empty'}}">
                {{selectedServiceTargetIndex > -1 ? serviceTargets[selectedServiceTargetIndex].name : '默认本人'}}
              </text>
              <text class="material-symbols-outlined med-page__editor-picker-icon">expand_more</text>
            </view>
          </picker>
        </view>
        <view class="med-page__editor-row">
          <text class="med-page__editor-label">提醒时间</text>
          <view class="med-page__editor-time-row">
            <picker mode="time" value="{{timeDraft}}" bindchange="onTimeDraftChange">
              <view class="med-page__editor-time-picker">
                <text>{{timeDraft}}</text>
                <text class="material-symbols-outlined med-page__editor-picker-icon">schedule</text>
              </view>
            </picker>
            <view class="med-page__editor-time-add" bind:tap="addReminderTime" hover-class="btn-haptic">添加</view>
          </view>
          <view class="med-page__editor-time-list">
            <view class="med-page__editor-time-tag" wx:for="{{createForm.reminderTimes}}" wx:key="*this">
              <text>{{item}}</text>
              <text class="material-symbols-outlined med-page__editor-time-remove" data-time="{{item}}" bind:tap="removeReminderTime">close</text>
            </view>
          </view>
        </view>
        <view class="med-page__editor-row med-page__editor-row--2">
          <view class="med-page__editor-col">
            <text class="med-page__editor-label">开始日期</text>
            <picker mode="date" value="{{createForm.startDate}}" bindchange="onStartDateChange">
              <view class="med-page__editor-picker">
                <text class="med-page__editor-picker-val">{{createForm.startDate}}</text>
                <text class="material-symbols-outlined med-page__editor-picker-icon">event</text>
              </view>
            </picker>
          </view>
          <view class="med-page__editor-col">
            <text class="med-page__editor-label">结束日期</text>
            <picker mode="date" value="{{createForm.endDate}}" bindchange="onEndDateChange">
              <view class="med-page__editor-picker">
                <text class="med-page__editor-picker-val">{{createForm.endDate}}</text>
                <text class="material-symbols-outlined med-page__editor-picker-icon">event</text>
              </view>
            </picker>
          </view>
        </view>
        <view class="med-page__editor-row">
          <text class="med-page__editor-label">备注（选填）</text>
          <textarea class="med-page__editor-textarea" placeholder="如：饭后服用、出现不适请停药" placeholder-class="med-page__editor-textarea-placeholder" value="{{createForm.instructions}}" data-field="instructions" bindinput="onCreateInput" maxlength="200" />
        </view>
        <view class="med-page__editor-actions">
          <view class="med-page__editor-btn med-page__editor-btn--ghost" bind:tap="closeCreatePanel" hover-class="btn-haptic">取消</view>
          <view class="med-page__editor-btn med-page__editor-btn--primary {{submitting ? 'med-page__editor-btn--disabled' : ''}}" bind:tap="submitCreate" hover-class="btn-haptic">
            <text>{{submitting ? '提交中...' : '保存提醒'}}</text>
          </view>
        </view>
      </view>

      <block wx:else>
        <!-- 药物相互作用入口 -->
        <view class="med-page__drug-risk" wx:if="{{reminders.length > 1 && activeTab === 'active'}}" bind:tap="goDrugRisk" hover-class="btn-haptic">
          <view class="med-page__drug-risk-icon">
            <text class="material-symbols-outlined">vaccines</text>
          </view>
          <view class="med-page__drug-risk-body">
            <text class="med-page__drug-risk-title">AI 药师：用药组合风险评估</text>
            <text class="med-page__drug-risk-desc">检测正在服用的药物是否有相互作用</text>
          </view>
          <text class="material-symbols-outlined med-page__drug-risk-arrow">chevron_right</text>
        </view>

        <!-- 概览卡片 -->
        <view class="med-page__insight" wx:if="{{reminders.length > 0}}">
          <view class="med-page__insight-orb"></view>
          <view class="med-page__insight-top">
            <view class="med-page__insight-text">
              <text class="med-page__insight-title">健康提醒概览</text>
              <text class="med-page__insight-desc">用药与复诊安排都会同步展示在这里</text>
            </view>
            <view class="med-page__insight-heart">
              <text class="material-symbols-outlined med-page__insight-heart-icon">favorite</text>
            </view>
          </view>
          <view class="med-page__insight-progress">
            <view class="med-page__insight-progress-header">
              <text class="med-page__insight-progress-label">当前提醒</text>
              <view>
                <text class="med-page__insight-progress-value">{{reminders.length}}</text>
                <text class="med-page__insight-progress-unit">条</text>
              </view>
            </view>
            <view class="med-page__insight-bar">
              <view class="med-page__insight-bar-fill" style="width: 100%;"></view>
            </view>
          </view>
        </view>

        <!-- 用药列表 -->
        <view class="med-page__list" wx:if="{{reminders.length > 0}}">
          <view
            class="med-page__med-card anim-item anim-{{index < 5 ? index : 4}}"
            wx:for="{{reminders}}"
            wx:key="id"
          >
            <view class="med-page__med-header">
              <view class="med-page__med-icon-wrap">
                <text class="material-symbols-outlined med-page__med-icon">{{item.reminderType === 'follow_up' ? 'event_upcoming' : 'medication'}}</text>
              </view>
              <view class="med-page__med-info">
                <text class="med-page__med-name">{{item.medicineName}}</text>
                <text class="med-page__med-dosage">{{item.reminderType === 'follow_up' ? (item.dosage || '请按时复诊') : (item.dosage || '按医嘱服用')}}</text>
              </view>
              <text class="med-page__med-status med-page__med-status--{{item.status}}">{{item.status === 'active' ? '进行中' : item.status === 'paused' ? '已暂停' : item.status === 'completed' ? '已完成' : '已取消'}}</text>
            </view>
            <view class="med-page__med-body">
              <view class="med-page__med-row" wx:if="{{item.reminderTimes.length > 0}}">
                <text class="material-symbols-outlined med-page__med-row-icon">schedule</text>
                <view class="med-page__med-times">
                  <text
                    class="med-page__time-tag"
                    wx:for="{{item.reminderTimes}}"
                    wx:for-item="t"
                    wx:key="*this"
                  >{{t}}</text>
                </view>
              </view>
              <view class="med-page__med-row med-page__med-row--doses" wx:if="{{item.todayDoses.length > 0}}">
                <text class="material-symbols-outlined med-page__med-row-icon">task_alt</text>
                <view class="med-page__dose-list">
                  <view
                    wx:for="{{item.todayDoses}}"
                    wx:for-item="d"
                    wx:key="time"
                    class="med-page__dose-chip med-page__dose-chip--{{d.status}}"
                    data-reminderid="{{item.id}}"
                    data-time="{{d.time}}"
                    data-status="{{d.status}}"
                    catch:tap="onDoseTap"
                    hover-class="btn-haptic"
                  >
                    <text class="med-page__dose-chip-time">{{d.time}}</text>
                    <text class="med-page__dose-chip-status">{{d.statusLabel}}</text>
                  </view>
                </view>
              </view>
              <view class="med-page__med-row">
                <text class="material-symbols-outlined med-page__med-row-icon">event</text>
                <text class="med-page__med-row-text">{{item.startDateStr}} ~ {{item.endDateStr}}</text>
              </view>
              <view class="med-page__med-row" wx:if="{{item.notes}}">
                <text class="material-symbols-outlined med-page__med-row-icon">notes</text>
                <text class="med-page__med-row-text med-page__med-row-text--wrap">{{item.notes}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 空状态 -->
        <view class="med-page__empty" wx:if="{{reminders.length === 0}}">
          <view class="med-page__empty-icon-wrap">
            <text class="material-symbols-outlined med-page__empty-icon">medication</text>
          </view>
          <text class="med-page__empty-title">暂无提醒</text>
          <text class="med-page__empty-sub">点击右下角添加用药提醒，复诊提醒会由服务流程自动同步</text>
        </view>
      </block>

    </view>
  </scroll-view>

  <view class="med-page__fab" bind:tap="goAdd" hover-class="btn-haptic">
    <text class="material-symbols-outlined med-page__fab-icon">{{showCreatePanel ? 'close' : 'add'}}</text>
  </view>
</view>
