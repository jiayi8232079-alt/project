<view class="ai-sum">
  <view class="ai-sum__nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="ai-sum__nav-back" bind:tap="goBack" hover-class="btn-haptic">
      <text class="material-symbols-outlined">arrow_back_ios_new</text>
    </view>
    <text class="ai-sum__nav-title">AI 对话摘要</text>
    <view style="width:72rpx;"></view>
  </view>

  <view wx:if="{{pageNeedsLogin}}" class="page-login-gate">
    <view class="page-login-gate__card">
      <text class="page-login-gate__title">登录后查看对话摘要</text>
      <text class="page-login-gate__desc">AI 对话记录仅对关联家人展示，请先登录。</text>
      <button class="page-login-gate__btn" bind:tap="goLoginFromGate">去登录</button>
      <view class="page-login-gate__skip" bind:tap="backFromGate">返回</view>
    </view>
  </view>

  <scroll-view
    wx:else
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    class="ai-sum__scroll"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="ai-sum__body">
      <view wx:if="{{filterName}}" class="ai-sum__filter">
        <text class="material-symbols-outlined">smart_toy</text>
        <text>{{filterName}} 的对话</text>
      </view>

      <view wx:if="{{loaded && sessions.length === 0}}" class="ai-sum__empty">
        <text class="material-symbols-outlined ai-sum__empty-icon">forum</text>
        <text class="ai-sum__empty-title">暂无对话记录</text>
        <text class="ai-sum__empty-sub">老人与陪伴机器人对话后，这里会生成摘要</text>
      </view>

      <view wx:else class="ai-sum__items">
        <view
          wx:for="{{sessions}}"
          wx:key="id"
          class="ai-sess {{item.hasCrisis ? 'ai-sess--crisis' : ''}}"
          data-id="{{item.id}}"
          bind:tap="goDetail"
          hover-class="btn-haptic"
        >
          <view class="ai-sess__header">
            <text class="ai-sess__time">{{item.startedAtText}}</text>
            <view wx:if="{{item.hasCrisis}}" class="ai-sess__crisis-tag">
              <text class="material-symbols-outlined">warning</text>
              <text>需关注</text>
            </view>
          </view>
          <text class="ai-sess__summary {{item.hasSummary ? '' : 'ai-sess__summary--empty'}}">{{item.summary}}</text>
          <view wx:if="{{item.crisisWords}}" class="ai-sess__crisis-words">命中：{{item.crisisWords}}</view>
          <view class="ai-sess__footer">
            <text class="ai-sess__meta">
              <text class="material-symbols-outlined">chat_bubble</text>
              {{item.turns}} 轮对话
            </text>
            <text wx:if="{{item.durationText}}" class="ai-sess__meta">
              <text class="material-symbols-outlined">schedule</text>
              {{item.durationText}}
            </text>
            <text class="ai-sess__more">查看详情 ›</text>
          </view>
        </view>
      </view>

      <view style="height:60rpx;"></view>
    </view>
  </scroll-view>
</view>
