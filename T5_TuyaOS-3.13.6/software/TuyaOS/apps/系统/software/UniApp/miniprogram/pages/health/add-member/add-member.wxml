<view class="add-member">
  <!-- Glass Nav -->
  <view class="add-member__nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="add-member__nav-back" bind:tap="goBack">
      <text class="material-symbols-outlined add-member__nav-back-icon">arrow_back_ios_new</text>
    </view>
    <text class="add-member__nav-title">{{pageTitle}}</text>
    <view class="add-member__nav-spacer"></view>
  </view>

  <view wx:if="{{pageNeedsLogin}}" class="page-login-gate">
    <view class="page-login-gate__card">
      <text class="page-login-gate__title">登录后添加成员</text>
      <text class="page-login-gate__desc">服务对象需登录后管理。您可先返回，需要时再自愿登录。</text>
      <button class="page-login-gate__btn" bind:tap="goLoginFromGate">去登录</button>
      <view class="page-login-gate__skip" bind:tap="backFromGate">返回</view>
    </view>
  </view>

  <scroll-view wx:else scroll-y class="add-member__scroll" enhanced show-scrollbar="{{false}}">
    <view class="add-member__body">

      <!-- Avatar Upload -->
      <view class="add-member__avatar-section">
        <view class="add-member__avatar-wrap">
          <view class="add-member__avatar">
            <text class="material-symbols-outlined add-member__avatar-placeholder">person</text>
          </view>
          <view class="add-member__avatar-camera">
            <text class="material-symbols-outlined add-member__avatar-camera-icon">photo_camera</text>
          </view>
        </view>
        <text class="add-member__avatar-hint">上传头像</text>
      </view>

      <!-- Form Card -->
      <view class="add-member__form-card">
        <!-- Name -->
        <view class="add-member__form-row">
          <text class="add-member__form-label">姓名</text>
          <input
            class="add-member__form-input"
            placeholder="请输入真实姓名"
            placeholder-class="add-member__placeholder"
            value="{{name}}"
            bindinput="onNameInput"
          />
        </view>

        <!-- Relation Tags -->
        <view class="add-member__form-row add-member__form-row--column">
          <text class="add-member__form-label add-member__form-label--block">与本人关系</text>
          <view class="add-member__tag-group">
            <view
              wx:for="{{relations}}"
              wx:key="value"
              class="add-member__tag {{relationship === item.value ? 'add-member__tag--active' : ''}} {{item.disabled ? 'add-member__tag--disabled' : ''}}"
              bind:tap="onRelationTap"
              data-value="{{item.value}}"
            >
              <text>{{item.label}}{{item.disabled ? '（已存在）' : ''}}</text>
            </view>
          </view>
          <text class="add-member__relation-hint">本人、父亲、母亲、配偶各仅可保留 1 份档案；所有档案都会同步到我的家庭。</text>
        </view>

        <!-- Gender -->
        <view class="add-member__form-row add-member__form-row--column">
          <text class="add-member__form-label add-member__form-label--block">性别</text>
          <view class="add-member__tag-group">
            <view
              wx:for="{{genders}}"
              wx:key="value"
              class="add-member__tag {{gender === item.value ? 'add-member__tag--active' : ''}}"
              bind:tap="onGenderTap"
              data-value="{{item.value}}"
            >
              <text>{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- Phone -->
        <view class="add-member__form-row">
          <text class="add-member__form-label">手机号码</text>
          <input
            class="add-member__form-input"
            type="number"
            maxlength="11"
            placeholder="请输入11位手机号码"
            placeholder-class="add-member__placeholder"
            value="{{phone}}"
            bindinput="onPhoneInput"
          />
        </view>

        <!-- ID Card -->
        <view class="add-member__form-row add-member__form-row--column add-member__form-row--last">
          <text class="add-member__form-label add-member__form-label--block">身份证号</text>
          <input
            class="add-member__form-input add-member__form-input--full"
            type="idcard"
            maxlength="18"
            placeholder="请输入18位身份证号码"
            placeholder-class="add-member__placeholder"
            value="{{idCard}}"
            bindinput="onIdCardInput"
          />
          <view wx:if="{{idCardParsed}}" class="add-member__id-hint">
            <text class="add-member__id-hint-item">出生：{{idCardBirth}}</text>
            <text class="add-member__id-hint-item">年龄：{{idCardAge}}岁</text>
            <text class="add-member__id-hint-item add-member__id-hint-ok">✓ 已自动识别</text>
          </view>
          <view wx:elif="{{idCard.length === 18}}" class="add-member__id-error">
            身份证号格式有误，请检查
          </view>
        </view>
      </view>

      <!-- Privacy Hint -->
      <view class="add-member__privacy">
        <text class="add-member__privacy-text">
          我们将保护您家人的隐私信息，仅用于医疗服务预约。
        </text>
      </view>

    </view>
  </scroll-view>

  <!-- Bottom Bar -->
  <view class="add-member__bottom-bar">
    <button class="add-member__submit-btn" bind:tap="onSubmit" disabled="{{submitting}}">
      {{isEdit ? '保存修改' : '确认并保存'}}
    </button>
  </view>
</view>
