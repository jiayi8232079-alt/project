<wxs module="utils">
module.exports = {
  includes: function(arr, val) {
    return arr && arr.indexOf(val) !== -1;
  }
};
</wxs>

<view class="profile-page">

  <!-- 导航栏 -->
  <view class="profile-page__nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="profile-page__nav-back" bind:tap="goBack" hover-class="btn-haptic">
      <text class="material-symbols-outlined profile-page__nav-back-icon">arrow_back</text>
    </view>
    <text class="profile-page__nav-title">{{isQrMode ? '健康档案填写' : (isNew ? '建立健康档案' : '健康档案')}}</text>
    <view class="profile-page__nav-more"></view>
  </view>

  <view wx:if="{{pageNeedsLogin}}" class="page-login-gate">
    <view class="page-login-gate__card">
      <text class="page-login-gate__title">登录后管理档案</text>
      <text class="page-login-gate__desc">健康档案仅本人账号可填写与查看。您可先返回，需要建档时再自愿登录。</text>
      <button class="page-login-gate__btn" bind:tap="goLoginFromGate">去登录</button>
      <view class="page-login-gate__skip" bind:tap="backFromGate">返回</view>
    </view>
  </view>

  <!-- 滚动区域 -->
  <scroll-view wx:else scroll-y enhanced show-scrollbar="{{false}}" class="profile-page__scroll">
    <view class="profile-page__body">

      <!-- 头部信息 -->
      <view class="profile-page__header">
        <view class="profile-page__avatar-wrap">
          <view class="profile-page__avatar-ring">
            <view class="profile-page__avatar">
              <text class="profile-page__avatar-initial">{{targetName[0] || ''}}</text>
            </view>
          </view>
          <view class="profile-page__avatar-check" wx:if="{{!isNew}}">
            <text class="material-symbols-outlined profile-page__avatar-check-icon">check</text>
          </view>
        </view>
        <text class="profile-page__header-name">{{targetName}}</text>
        <text class="profile-page__header-meta">{{targetGender}}{{targetAge ? ' · ' + targetAge + '岁' : ''}}</text>
      </view>

      <!-- 基本信息 -->
      <view class="profile-page__section">
        <view class="profile-page__section-title">
          <view class="profile-page__section-bar"></view>
          基本信息
        </view>
        <view class="profile-page__info-grid">
          <view class="profile-page__info-item">
            <text class="profile-page__info-label">姓名</text>
            <text class="profile-page__info-value profile-page__info-value--readonly">{{form.name}}</text>
          </view>
          <view class="profile-page__info-item">
            <text class="profile-page__info-label">性别</text>
            <text class="profile-page__info-value profile-page__info-value--readonly">{{form.gender}}</text>
          </view>
          <view class="profile-page__info-item">
            <text class="profile-page__info-label">年龄</text>
            <text class="profile-page__info-value profile-page__info-value--readonly">{{form.age}}{{form.age ? '岁' : ''}}</text>
          </view>
          <view class="profile-page__info-item">
            <text class="profile-page__info-label">手机号码</text>
            <text class="profile-page__info-value profile-page__info-value--readonly">{{form.phone}}</text>
          </view>
          <view class="profile-page__info-item profile-page__info-item--full profile-page__address-section">
            <text class="profile-page__info-label">家庭地址</text>
            <picker mode="region" value="{{form.homeRegion}}" bindchange="onRegionChange">
              <view class="profile-page__region-picker">
                <text wx:if="{{form.homeRegionText}}" class="profile-page__region-text">{{form.homeRegionText}}</text>
                <text wx:else class="profile-page__region-placeholder">请选择省/市/区</text>
                <text class="material-symbols-outlined profile-page__region-arrow">expand_more</text>
              </view>
            </picker>
            <input class="profile-page__info-input profile-page__address-detail" placeholder="请输入详细地址（街道、门牌号等）" value="{{form.homeAddressDetail}}" data-field="homeAddressDetail" bindinput="onInput" maxlength="200" />
          </view>
          <view class="profile-page__info-item profile-page__info-item--full">
            <text class="profile-page__info-label">身份证号</text>
            <input class="profile-page__info-input" placeholder="请输入18位身份证号（必填）" value="{{form.idCard}}" data-field="idCard" bindinput="onInput" maxlength="18" />
          </view>
        </view>
      </view>

      <!-- 紧急联系人 -->
      <view class="profile-page__section">
        <view class="profile-page__section-title">
          <view class="profile-page__section-bar"></view>
          紧急联系人
        </view>
        <view class="profile-page__emergency-form">
          <view class="profile-page__picker-row">
            <text class="profile-page__picker-label">联系人</text>
            <input
              class="profile-page__picker-input"
              placeholder="请输入紧急联系人姓名"
              value="{{form.emergencyContact}}"
              data-field="emergencyContact"
              bindinput="onInput"
              maxlength="20"
            />
          </view>
          <view class="profile-page__picker-row">
            <text class="profile-page__picker-label">与本人关系</text>
            <picker
              mode="selector"
              range="{{emergencyRelationOptions}}"
              bindchange="onEmergencyRelationChange"
              style="flex:1;"
            >
              <view style="display:flex;align-items:center;justify-content:flex-end;">
                <text class="profile-page__picker-value {{!form.emergencyRelation ? 'profile-page__picker-placeholder' : ''}}">{{form.emergencyRelation || '请选择关系'}}</text>
                <text class="material-symbols-outlined profile-page__picker-arrow">expand_more</text>
              </view>
            </picker>
          </view>
          <view class="profile-page__picker-row profile-page__picker-row--last">
            <text class="profile-page__picker-label">联系电话</text>
            <input
              class="profile-page__picker-input"
              type="number"
              placeholder="请输入11位手机号"
              value="{{form.emergencyPhone}}"
              bindinput="onEmergencyPhoneInput"
              maxlength="11"
            />
          </view>
        </view>
      </view>

      <!-- 信息记录方式（与打印档案一致） -->
      <view class="profile-page__section">
        <view class="profile-page__section-title">
          <view class="profile-page__section-bar"></view>
          信息记录方式
        </view>
        <view class="profile-page__tag-list">
          <view class="profile-page__medical-tag {{form.fillMethod === 'self' ? 'profile-page__medical-tag--blue' : 'profile-page__medical-tag--muted'}}" data-val="self" bind:tap="setFillMethod">本人自填</view>
          <view class="profile-page__medical-tag {{form.fillMethod === 'dictation' ? 'profile-page__medical-tag--blue' : 'profile-page__medical-tag--muted'}}" data-val="dictation" bind:tap="setFillMethod">本人口述代填</view>
          <view class="profile-page__medical-tag {{form.fillMethod === 'proxy' ? 'profile-page__medical-tag--blue' : 'profile-page__medical-tag--muted'}}" data-val="proxy" bind:tap="setFillMethod">家属代填</view>
          <view class="profile-page__medical-tag {{form.fillMethod === 'other' ? 'profile-page__medical-tag--blue' : 'profile-page__medical-tag--muted'}}" data-val="other" bind:tap="setFillMethod">其他</view>
        </view>

        <!-- 家属代填 / 其他：显示填写人信息 -->
        <view wx:if="{{form.fillMethod === 'proxy' || form.fillMethod === 'other'}}" class="profile-page__signer-info">
          <view class="profile-page__signer-info-title">
            <text class="material-symbols-outlined profile-page__signer-info-icon">person_add</text>
            <text>填写人信息</text>
          </view>
          <view class="profile-page__picker-row">
            <text class="profile-page__picker-label">填写人姓名</text>
            <input
              class="profile-page__picker-input"
              placeholder="请输入填写人的真实姓名"
              value="{{form.signerName}}"
              data-field="signerName"
              bindinput="onInput"
              maxlength="20"
            />
          </view>
          <view class="profile-page__signer-relation-title">与档案人「{{form.name}}」的关系</view>
          <view class="profile-page__tag-list">
            <view
              wx:for="{{signerRelationOptions}}"
              wx:key="value"
              class="profile-page__medical-tag {{form.signerRelation === item.value ? 'profile-page__medical-tag--blue' : 'profile-page__medical-tag--muted'}}"
              data-val="{{item.value}}"
              bind:tap="setSignerRelation"
            >{{item.label}}</view>
          </view>
        </view>
      </view>

      <!-- 行动能力 -->
      <view class="profile-page__section">
        <view class="profile-page__section-title">
          <view class="profile-page__section-bar"></view>
          行动能力
        </view>
        <view class="profile-page__tag-list">
          <view class="profile-page__medical-tag {{form.mobilityStatus === 'independent' ? 'profile-page__medical-tag--blue' : 'profile-page__medical-tag--muted'}}" data-val="independent" bind:tap="setMobilityStatus">行动自如</view>
          <view class="profile-page__medical-tag {{form.mobilityStatus === 'mild_assist' ? 'profile-page__medical-tag--orange' : 'profile-page__medical-tag--muted'}}" data-val="mild_assist" bind:tap="setMobilityStatus">需轻度辅助</view>
          <view class="profile-page__medical-tag {{form.mobilityStatus === 'wheelchair' ? 'profile-page__medical-tag--orange' : 'profile-page__medical-tag--muted'}}" data-val="wheelchair" bind:tap="setMobilityStatus">需轮椅</view>
          <view class="profile-page__medical-tag {{form.mobilityStatus === 'bedridden' ? 'profile-page__medical-tag--red' : 'profile-page__medical-tag--muted'}}" data-val="bedridden" bind:tap="setMobilityStatus">卧床</view>
        </view>
      </view>

      <!-- 血型 -->
      <view class="profile-page__section">
        <view class="profile-page__section-title">
          <view class="profile-page__section-bar"></view>
          血型
        </view>
        <view class="profile-page__tag-list">
          <view
            wx:for="{{bloodTypeOptions}}"
            wx:key="*this"
            class="profile-page__medical-tag {{form.bloodType === item ? 'profile-page__medical-tag--red' : 'profile-page__medical-tag--muted'}}"
            data-val="{{item}}"
            bind:tap="setBloodType"
          >{{item}}</view>
        </view>
      </view>

      <!-- 过敏史 -->
      <view class="profile-page__section">
        <view class="profile-page__section-title">
          <view class="profile-page__section-bar"></view>
          过敏史
        </view>
        <view class="profile-page__tag-list">
          <view class="profile-page__medical-tag {{form.allergyStatus === 'none' ? 'profile-page__medical-tag--blue' : 'profile-page__medical-tag--muted'}}" data-val="none" bind:tap="setAllergyStatus">无</view>
          <view class="profile-page__medical-tag {{form.allergyStatus === 'has' ? 'profile-page__medical-tag--red' : 'profile-page__medical-tag--muted'}}" data-val="has" bind:tap="setAllergyStatus">有</view>
        </view>
        <view wx:if="{{form.allergyStatus === 'has'}}" class="profile-page__sub-input">
          <text class="profile-page__sub-label">过敏源</text>
          <textarea
            class="profile-page__textarea"
            placeholder="请输入过敏源，如：青霉素、海鲜、花粉等"
            value="{{form.allergies}}"
            data-field="allergies"
            bindinput="onInput"
            auto-height
            maxlength="500"
          ></textarea>
        </view>
      </view>

      <!-- 既往病史 -->
      <view class="profile-page__section">
        <view class="profile-page__section-title">
          <view class="profile-page__section-bar"></view>
          既往病史
        </view>
        <view class="profile-page__tag-list">
          <view
            wx:for="{{medicalHistoryOptions}}"
            wx:key="value"
            class="profile-page__medical-tag {{utils.includes(form.medicalHistoryArr, item.value) ? 'profile-page__medical-tag--red' : 'profile-page__medical-tag--muted'}}"
            data-val="{{item.value}}"
            bind:tap="toggleMedHistory"
          >{{item.label}}</view>
        </view>
        <view wx:if="{{utils.includes(form.medicalHistoryArr, 'other')}}" class="profile-page__sub-input">
          <input class="profile-page__textarea profile-page__textarea--single" placeholder="请补充其他病史" value="{{form.medicalHistoryOther}}" data-field="medicalHistoryOther" bindinput="onInput" />
        </view>
      </view>

      <!-- 视力情况 -->
      <view class="profile-page__section">
        <view class="profile-page__section-title">
          <view class="profile-page__section-bar"></view>
          视力情况
        </view>
        <view class="profile-page__tag-list">
          <view class="profile-page__medical-tag {{form.visionStatus === 'good' ? 'profile-page__medical-tag--blue' : 'profile-page__medical-tag--muted'}}" data-val="good" bind:tap="setVision">正常</view>
          <view class="profile-page__medical-tag {{form.visionStatus === 'poor' ? 'profile-page__medical-tag--orange' : 'profile-page__medical-tag--muted'}}" data-val="poor" bind:tap="setVision">视力减退</view>
          <view class="profile-page__medical-tag {{form.visionStatus === 'blind' ? 'profile-page__medical-tag--red' : 'profile-page__medical-tag--muted'}}" data-val="blind" bind:tap="setVision">严重视力障碍</view>
        </view>
      </view>

      <!-- 听力情况 -->
      <view class="profile-page__section">
        <view class="profile-page__section-title">
          <view class="profile-page__section-bar"></view>
          听力情况
        </view>
        <view class="profile-page__tag-list">
          <view class="profile-page__medical-tag {{form.hearingStatus === 'good' ? 'profile-page__medical-tag--blue' : 'profile-page__medical-tag--muted'}}" data-val="good" bind:tap="setHearing">正常</view>
          <view class="profile-page__medical-tag {{form.hearingStatus === 'poor' ? 'profile-page__medical-tag--orange' : 'profile-page__medical-tag--muted'}}" data-val="poor" bind:tap="setHearing">听力减退</view>
          <view class="profile-page__medical-tag {{form.hearingStatus === 'deaf' ? 'profile-page__medical-tag--red' : 'profile-page__medical-tag--muted'}}" data-val="deaf" bind:tap="setHearing">严重听力障碍</view>
        </view>
      </view>

      <!-- 近期状况 -->
      <view class="profile-page__section">
        <view class="profile-page__section-title">
          <view class="profile-page__section-bar"></view>
          近期状况
        </view>
        <view class="profile-page__tag-list">
          <view
            wx:for="{{recentSymptomsOptions}}"
            wx:key="value"
            class="profile-page__medical-tag {{utils.includes(form.recentSymptoms, item.value) ? 'profile-page__medical-tag--orange' : 'profile-page__medical-tag--muted'}}"
            data-val="{{item.value}}"
            bind:tap="toggleRecentSymptom"
          >{{item.label}}</view>
        </view>
        <textarea
          wx:if="{{utils.includes(form.recentSymptoms, 'other')}}"
          class="profile-page__textarea"
          placeholder="请描述其他近期症状"
          value="{{form.recentSymptomsOther}}"
          data-field="recentSymptomsOther"
          bindinput="onInput"
          maxlength="500"
          auto-height
          style="margin-top: 16rpx;"
        />
      </view>

      <!-- 当前用药 -->
      <view class="profile-page__section">
        <view class="profile-page__section-title">
          <view class="profile-page__section-bar"></view>
          当前用药
        </view>
        <textarea
          class="profile-page__textarea"
          placeholder="如：拜阿司匹林 100mg 每日一次、氨氯地平 5mg 每日一次（无则留空）"
          value="{{form.currentMedication}}"
          data-field="currentMedication"
          bindinput="onInput"
          auto-height
          maxlength="1000"
        ></textarea>
      </view>

      <!-- 就医具体诉求 -->
      <view class="profile-page__section">
        <view class="profile-page__section-title">
          <view class="profile-page__section-bar"></view>
          就医具体诉求
        </view>
        <textarea
          class="profile-page__textarea"
          placeholder="请描述本次就医的具体诉求，例如：长期头痛需排查原因、糖尿病复查等"
          value="{{form.chiefComplaint}}"
          data-field="chiefComplaint"
          bindinput="onInput"
          auto-height
          maxlength="1000"
        ></textarea>
      </view>

      <!-- 签署确认 -->
      <view class="profile-page__section profile-page__section--sign">
        <view class="profile-page__section-title">
          <view class="profile-page__section-bar"></view>
          <text wx:if="{{isAdminMode}}">邀请签署</text>
          <text wx:else>信息确认签署</text>
        </view>
        <view class="profile-page__sign-notice">
          <text class="material-symbols-outlined profile-page__sign-notice-icon">info</text>
          <text wx:if="{{isAdminMode && (form.fillMethod === 'proxy' || form.fillMethod === 'other')}}" class="profile-page__sign-notice-text">管理员仅代填信息,需由代签人「{{form.signerName || '填写人'}}」完成签署,请转发给代签人。</text>
          <text wx:elif="{{isAdminMode}}" class="profile-page__sign-notice-text">管理员仅代填信息,需由档案人「{{form.name || '本人'}}」完成签署,请转发给档案人本人。</text>
          <text wx:elif="{{form.fillMethod === 'proxy' || form.fillMethod === 'other'}}" class="profile-page__sign-notice-text">我确认以上健康信息真实准确,愿意授权陪了个伴用于陪诊服务。由「{{form.signerName || '填写人'}}」代为填写并签署。</text>
          <text wx:else class="profile-page__sign-notice-text">我确认以上健康信息真实准确,愿意授权陪了个伴用于陪诊服务。签署人应为档案人「{{form.name}}」本人。</text>
        </view>

        <!-- 客户重要提示勾选 -->
        <view class="profile-page__notice-check" bind:tap="toggleImportantNotice">
          <view class="profile-page__notice-checkbox {{importantNoticeRead ? 'profile-page__notice-checkbox--checked' : ''}}">
            <text wx:if="{{importantNoticeRead}}" class="material-symbols-outlined profile-page__notice-checkbox-icon">check</text>
          </view>
          <text class="profile-page__notice-check-text">我已阅读</text>
          <text class="profile-page__notice-check-link" catch:tap="showImportantNoticePopup">《客户重要提示》</text>
        </view>

        <!-- 管理员模式:邀请签署卡片(不可直接签署) -->
        <block wx:if="{{isAdminMode}}">
          <view wx:if="{{form.hasSigned}}" class="profile-page__admin-sign-panel profile-page__admin-sign-panel--done">
            <text class="material-symbols-outlined profile-page__admin-sign-icon">verified</text>
            <view class="profile-page__admin-sign-text">
              <text class="profile-page__admin-sign-title">已由「{{form.signatureName}}」签署</text>
              <text class="profile-page__admin-sign-sub">档案已完成签署,可正常使用</text>
            </view>
          </view>
          <view wx:else class="profile-page__admin-sign-panel profile-page__admin-sign-panel--pending">
            <view class="profile-page__admin-sign-head">
              <text class="material-symbols-outlined profile-page__admin-sign-icon">forward_to_inbox</text>
              <view class="profile-page__admin-sign-text">
                <text class="profile-page__admin-sign-title">由谁签署</text>
                <text wx:if="{{form.fillMethod === 'proxy' || form.fillMethod === 'other'}}" class="profile-page__admin-sign-sub">代签人 {{form.signerName || '(请先填写填写人)'}} · 关系:{{form.signerRelation || '请先选择'}}</text>
                <text wx:else class="profile-page__admin-sign-sub">档案人本人 {{form.name || ''}}</text>
              </view>
            </view>
            <button
              class="profile-page__admin-share-btn btn-reset"
              open-type="share"
              hover-class="btn-haptic"
            >
              <text class="material-symbols-outlined profile-page__admin-share-icon">share</text>
              <text>转发签署</text>
            </button>
          </view>
        </block>

        <!-- 普通模式:用户点击自己签署 -->
        <view wx:else class="profile-page__sign-panel {{form.hasSigned ? 'profile-page__sign-panel--readonly' : ''}}" bind:tap="goSign">
          <view wx:if="{{form.hasSigned}}" class="profile-page__sign-done">
            <text class="material-symbols-outlined profile-page__sign-done-icon">check_circle</text>
            <text class="profile-page__sign-done-text">已签署({{form.signatureName}})</text>
          </view>
          <view wx:else class="profile-page__sign-tap">
            <text class="material-symbols-outlined profile-page__sign-tap-icon">draw</text>
            <text wx:if="{{form.fillMethod === 'proxy' || form.fillMethod === 'other'}}" class="profile-page__sign-tap-text">点击签署「{{form.signerName || '填写人'}}」的姓名</text>
            <text wx:else class="profile-page__sign-tap-text">点击签署档案人「{{form.name}}」的姓名</text>
          </view>
        </view>
      </view>

      <!-- 客户重要提示弹出层 -->
      <view wx:if="{{showImportantNotice}}" class="profile-page__notice-mask" bind:tap="closeImportantNotice">
        <view class="profile-page__notice-popup" catch:tap="">
          <view class="profile-page__notice-popup-header">
            <text class="profile-page__notice-popup-title">客户重要提示</text>
            <view class="profile-page__notice-popup-close" bind:tap="closeImportantNotice">
              <text class="material-symbols-outlined">close</text>
            </view>
          </view>
          <scroll-view scroll-y class="profile-page__notice-popup-body">
            <view class="profile-page__notice-content">
              <text class="profile-page__notice-intro">尊敬的客户，为确保本次陪诊服务顺利、安心，请您在签署前特别留意以下事项：</text>

              <view class="profile-page__notice-item">
                <text class="profile-page__notice-item-title">一、服务性质</text>
                <text class="profile-page__notice-item-text">我们提供的陪诊服务核心是生活辅助与事务协助，主要包括就诊引导、排队、缴费、取药、陪同及医嘱记录等。请您知悉陪诊员不是医疗专业人员，不会提供任何诊断、治疗、用药指导或病情判断等医疗服务。</text>
              </view>

              <view class="profile-page__notice-item">
                <text class="profile-page__notice-item-title">二、健康信息是安全基石</text>
                <text class="profile-page__notice-item-text">您填写的《陪了个伴客户健康信息小档案》是我们为您提供安全、周到服务的重要依据。请确保所提供的信息真实、完整，这将帮助我们更好地为您规划服务。若因健康信息隐瞒、遗漏或不实而导致任何风险，相关责任需由您自行承担。</text>
              </view>

              <view class="profile-page__notice-item">
                <text class="profile-page__notice-item-title">三、费用透明说明</text>
                <text class="profile-page__notice-item-text">医疗费用：就诊过程中的挂号、医药、检查等费用，均需由您在现场自行支付，陪诊员不提供垫付服务。\n\n公司预收的准备金：用于协助客户交通出行和住宿费用，服务结束后按实际产生的费用结算，多退少补。</text>
              </view>

              <view class="profile-page__notice-item">
                <text class="profile-page__notice-item-title">四、取消与改期规则</text>
                <text class="profile-page__notice-item-text">如您需要取消或改期，请务必提前联系我们，我们将按以下标准处理：\n\n• 服务开始前36小时以上取消：全额退款\n• 服务开始前24–36小时（含）取消：扣除基础服务费的10%作为违约金\n• 服务开始前12–24小时（含）取消：扣除基础服务费的30%作为违约金\n• 服务开始前不足12小时取消：已收取的基础服务费将不予退还\n\n请您提前规划，以免造成不必要的损失。</text>
              </view>

              <view class="profile-page__notice-item">
                <text class="profile-page__notice-item-title">五、随身资料准备</text>
                <text class="profile-page__notice-item-text">为保障就诊流程顺畅，请您务必带齐以下资料：\n\n• 必备证件：身份证、医保卡/社保卡\n• 病史资料：过往病历本、近期检查报告、影像资料（如CT、MRI片）等\n• 预约凭证：医院预约成功短信、挂号截图或相关预约单\n• 支付工具：足够金额的银行卡、手机支付或现金，用于支付医疗费用\n\n陪诊员将在服务前与您确认，也请您提前备好。</text>
              </view>

              <view class="profile-page__notice-item">
                <text class="profile-page__notice-item-title">六、紧急情况处理</text>
                <text class="profile-page__notice-item-text">如在服务期间，服务接受方突发身体不适，陪诊员将立即协助呼叫现场医护人员或拨打120，并联系您预留的紧急联系人。履行上述应急协助后，后续医疗事宜及结果需由您方自行负责。</text>
              </view>

              <view class="profile-page__notice-item">
                <text class="profile-page__notice-item-title">七、保险建议</text>
                <text class="profile-page__notice-item-text">我们诚挚建议您根据个人情况，自行购买合适的商业意外保险（建议保额50万元及以上），为您的出行增添一份安心保障。</text>
              </view>

              <view class="profile-page__notice-item">
                <text class="profile-page__notice-item-title">八、服务保障提示</text>
                <text class="profile-page__notice-item-text">如您需咨询或反馈，请拨打公司客服电话 17357867655，或联系公司企业微信客服。</text>
              </view>
            </view>
          </scroll-view>
          <view class="profile-page__notice-popup-footer">
            <view class="profile-page__notice-popup-btn" bind:tap="confirmImportantNotice">
              我已阅读并知晓
            </view>
          </view>
        </view>
      </view>

      <!-- 底部按钮 -->
      <view class="profile-page__bottom-space">
        <view class="profile-page__save-btn" bind:tap="handleSave" hover-class="btn-haptic">
          <text class="material-symbols-outlined profile-page__save-icon">check_circle</text>
          <text wx:if="{{isAdminMode && !form.hasSigned}}">保存档案(待签署)</text>
          <text wx:elif="{{isAdminMode}}">保存档案</text>
          <text wx:else>{{isNew ? '确认提交健康档案' : '确认保存修改'}}</text>
        </view>
        <view wx:if="{{canViewSignedDoc}}" class="profile-page__save-btn profile-page__save-btn--outline" bind:tap="viewSignedDoc" hover-class="btn-haptic">
          <text class="material-symbols-outlined profile-page__save-icon">health_and_safety</text>
          <text>查看健康小档案</text>
        </view>
      </view>

    </view>
  </scroll-view>

  <!-- 分享卡片 Canvas（隐藏在屏幕外，供 renderHealthSignShareCover 绘制封面图） -->
  <canvas type="2d" id="share-cover-canvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"></canvas>
</view>
