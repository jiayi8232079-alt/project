<view class="add-elder">
  <scroll-view scroll-y class="add-elder__scroll" enhanced show-scrollbar="{{false}}">

    <!-- 创建者身份 -->
    <view class="add-elder__card">
      <text class="add-elder__section-title">创建者身份</text>
      <view class="add-elder__hint">请如实选择；子女代建老人档案必须签署电子委托书</view>

      <view wx:for="{{delegatorRelations}}" wx:key="value"
            class="add-elder__dele {{form.delegatorRelation === item.value ? 'add-elder__dele--active' : ''}}"
            bind:tap="selectDelegator" data-value="{{item.value}}" hover-class="btn-haptic">
        <view class="add-elder__dele-radio">
          <view wx:if="{{form.delegatorRelation === item.value}}" class="add-elder__dele-dot"></view>
        </view>
        <view class="add-elder__dele-info">
          <text class="add-elder__dele-label">{{item.label}}</text>
          <text class="add-elder__dele-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="add-elder__card">
      <text class="add-elder__section-title">老人基本信息</text>

      <view class="add-elder__row">
        <text class="add-elder__label">姓名<text class="add-elder__required">*</text></text>
        <input class="add-elder__input" placeholder="请输入" value="{{form.name}}"
               bindinput="onInput" data-field="name" />
      </view>

      <view class="add-elder__row">
        <text class="add-elder__label">关系<text class="add-elder__required">*</text></text>
        <view class="add-elder__tags">
          <view wx:for="{{relations}}" wx:key="value"
                class="add-elder__tag {{form.relation === item.value ? 'add-elder__tag--active' : ''}}"
                bind:tap="selectRelation" data-value="{{item.value}}" hover-class="btn-haptic">{{item.label}}</view>
        </view>
      </view>

      <view class="add-elder__row">
        <text class="add-elder__label">性别</text>
        <view class="add-elder__tags">
          <view wx:for="{{genders}}" wx:key="*this" wx:for-item="g"
                class="add-elder__tag {{form.gender === g ? 'add-elder__tag--active' : ''}}"
                bind:tap="selectGender" data-value="{{g}}" hover-class="btn-haptic">{{g}}</view>
        </view>
      </view>

      <view class="add-elder__row">
        <text class="add-elder__label">出生年月</text>
        <picker mode="date" value="{{form.birthDate}}" bindchange="onBirthChange" end="2025-01-01" fields="day" class="add-elder__picker">
          <view class="add-elder__picker-val {{!form.birthDate ? 'add-elder__picker-val--muted' : ''}}">
            {{form.birthDate || '请选择日期'}}{{form.age ? ' · ' + form.age + '岁' : ''}}
          </view>
        </picker>
      </view>

      <view class="add-elder__row">
        <text class="add-elder__label">手机号</text>
        <input class="add-elder__input" placeholder="选填；填入后老人可用此号登录自动进家庭"
               value="{{form.phone}}" type="number" maxlength="11"
               bindinput="onInput" data-field="phone" />
      </view>

      <view class="add-elder__row">
        <text class="add-elder__label">身份证号</text>
        <input class="add-elder__input" placeholder="选填" value="{{form.idCard}}" maxlength="18"
               bindinput="onInput" data-field="idCard" />
      </view>

      <view class="add-elder__row">
        <text class="add-elder__label">居住地址</text>
        <input class="add-elder__input" placeholder="选填" value="{{form.homeAddress}}"
               bindinput="onInput" data-field="homeAddress" />
      </view>
    </view>

    <!-- 健康情况 -->
    <view class="add-elder__card">
      <text class="add-elder__section-title">健康情况</text>

      <view class="add-elder__row add-elder__row--block">
        <text class="add-elder__label">既往疾病</text>
        <view class="add-elder__tags add-elder__tags--wrap">
          <view wx:for="{{medicalHistoryOptions}}" wx:key="value"
                class="add-elder__tag {{form.medicalHistory.indexOf(item.value) >= 0 ? 'add-elder__tag--active' : ''}}"
                bind:tap="toggleMedical" data-value="{{item.value}}" hover-class="btn-haptic">{{item.label}}</view>
        </view>
      </view>

      <view class="add-elder__row add-elder__row--block">
        <text class="add-elder__label">长期用药</text>
        <textarea class="add-elder__textarea" placeholder="例如：厄贝沙坦 早 1 片" value="{{form.currentMedication}}"
                  bindinput="onInput" data-field="currentMedication" auto-height maxlength="300"></textarea>
      </view>

      <view class="add-elder__row add-elder__row--block">
        <text class="add-elder__label">过敏史</text>
        <textarea class="add-elder__textarea" placeholder="药物、食物过敏等；无则留空" value="{{form.allergies}}"
                  bindinput="onInput" data-field="allergies" auto-height maxlength="200"></textarea>
      </view>
    </view>

    <!-- 紧急联系人 -->
    <view class="add-elder__card">
      <text class="add-elder__section-title">紧急联系人</text>

      <view class="add-elder__row">
        <text class="add-elder__label">联系人</text>
        <input class="add-elder__input" placeholder="默认为您本人" value="{{form.emergencyContact}}"
               bindinput="onInput" data-field="emergencyContact" />
      </view>

      <view class="add-elder__row">
        <text class="add-elder__label">联系电话</text>
        <input class="add-elder__input" placeholder="可拨打的紧急电话" value="{{form.emergencyPhone}}"
               type="number" maxlength="11" bindinput="onInput" data-field="emergencyPhone" />
      </view>
    </view>

    <!-- 提示 -->
    <view wx:if="{{form.delegatorRelation === 'child'}}" class="add-elder__notice" bind:tap="toggleAgreement" hover-class="btn-haptic">
      <text class="material-symbols-outlined add-elder__notice-icon">info</text>
      <text class="add-elder__notice-text">点击下方"下一步"后，将进入《老人托管服务委托书》电子签署页面，签署成功才能完成档案激活。</text>
    </view>

    <view style="height: 200rpx;"></view>
  </scroll-view>

  <view class="add-elder__footer" style="padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);">
    <button class="add-elder__submit {{submitting ? 'add-elder__submit--disabled' : ''}}"
            bind:tap="submit" disabled="{{submitting}}" hover-class="btn-haptic">
      {{submitting ? '提交中...' : (form.delegatorRelation === 'child' ? '下一步：签署委托协议' : '保存老人档案')}}
    </button>
  </view>
</view>
