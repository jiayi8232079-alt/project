# output / 本地工具目录
dist
.build
.cache
# Cursor：忽略会话与缓存；保留 README 与 rules（团队可提交复用）
.cursor/**
!.cursor/README.md
!.cursor/rules/
!.cursor/rules/**
.claude/
ai_components/assets/include/lang_config.h
compile_commands.json


# TuyaOS / xmake：编译输出（勿写全局 output/，否则会忽略源码目录如 audio/output/）
**/software/TuyaOS/output/
# 应用级产物目录（make 创建 apps/$(APP_NAME)/output）；与源码目录 src/.../audio/output 区分
# 含 tuyaos_jiajia / tuyaos_demo_wukong_ai 等：*_QIO_*.bin、*_UA_*.bin、*_UG_*.bin、debug/
**/software/TuyaOS/apps/*/output/

# 构建生成的临时配置头与中间文件（非手改源码）
# tmp/TuyaOS/libs/：从 packages/*.tar.gz 解压的闭源 libtuyaos.a 等，勿入库
**/software/TuyaOS/tmp/

# SDK 侧生成的构建参数（prepare_app.sh 按 APP_NAME 重写）
**/software/TuyaOS/build/build_param
**/software/TuyaOS/output/.app_build_fingerprint

# make 生成的应用静态库（完整包体积大；*.a 不匹配 *.a.stripped）
**/software/TuyaOS/libs/libtuyaos_*.a
**/software/TuyaOS/libs/libtuyaos_*.a.stripped

# T5 芯片侧 ninja/链接中间产物（切换 APP_NAME 编译会改大量文件）
**/software/TuyaOS/vendor/T5/t5_os/build/

# 本地 SDK 压缩包目录（与根目录 *.tar.gz 规则一致）
**/software/TuyaOS/packages/

# 已解压的 SDK 与 .tar.gz 二选一即可；若必须把某个压缩包纳入版本库可用 git add -f 路径
*.tar.gz

# GitHub 单文件上限 100MB：平台 zip 与 ARM 工具链整包勿提交（本地保留，从官方/涂鸦下载）
**/T5_0.0.75.zip
**/gcc-arm-none-eabi-*.tar

# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb
*.build
app_default.config
# 仅忽略仓库根下 doc/（勿写 doc/，否则会误伤 apps/*/doc/ 等应用文档）
/doc/
*.log
# 串口抓取日志（常含 token / devId 等，勿入库）
uart_log.txt
**/uart_log.txt

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo
