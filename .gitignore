# output / 本地工具目录
dist
.build
.cache
# Cursor：忽略会话与缓存；保留 README 与 rules（团队可提交复用）
.cursor/**
!.cursor/README.md
!.cursor/rules/
!.cursor/rules/**
.claude/
ai_components/assets/include/lang_config.h
compile_commands.json


# TuyaOS / xmake：编译输出（勿写全局 output/，否则会忽略源码目录如 audio/output/）
**/software/TuyaOS/output/
# 应用级产物目录（make 创建 apps/$(APP_NAME)/output）；与源码目录 src/.../audio/output 区分
**/software/TuyaOS/apps/*/output/

# 构建生成的临时配置头与中间文件（非手改源码）
**/software/TuyaOS/tmp/

# 已解压的 SDK 与 .tar.gz 二选一即可；若必须把某个压缩包纳入版本库可用 git add -f 路径
*.tar.gz

# GitHub 单文件上限 100MB：平台 zip 与 ARM 工具链整包勿提交（本地保留，从官方/涂鸦下载）
**/T5_0.0.75.zip
**/gcc-arm-none-eabi-*.tar

# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries（*.a 需纳入版本库：TuyaOS/libs 预编译 SDK 等；中间产物仍由 output/、tmp/ 忽略）
*.lib
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb
*.build
app_default.config
# 仅忽略仓库根下 doc/（勿写 doc/，否则会误伤 apps/*/doc/ 等应用文档）
/doc/
*.log
# 串口抓取日志（常含 token / devId 等，勿入库）
uart_log.txt
**/uart_log.txt

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo
